# Groq (OpenAI-compatible) for answer generation and VLM figure understanding.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
VLM_MODEL=qwen/qwen3.8-27b
ENABLE_VLM=true

# auto | sentence-transformers | hashing
# (Groq has no embeddings API; "openai" only works with a different LLM_BASE_URL that serves embeddings.)
EMBEDDING_BACKEND=auto
# auto | cross-encoder | llm | lexical | none
RERANKER_BACKEND=auto

SECRET_KEY=change-me
PORT=5000
