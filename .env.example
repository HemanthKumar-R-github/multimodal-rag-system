# OpenAI-compatible endpoint for answer generation, VLM figure understanding and (optionally) embeddings.
# Works with Vercel AI Gateway (default), OpenAI (https://api.openai.com/v1 + model "gpt-4o-mini"), Ollama, vLLM...
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
VLM_MODEL=openai/gpt-4o-mini
ENABLE_VLM=true

# auto | sentence-transformers | openai | hashing
EMBEDDING_BACKEND=auto
# auto | cross-encoder | llm | lexical | none
RERANKER_BACKEND=auto

SECRET_KEY=change-me
PORT=5000
